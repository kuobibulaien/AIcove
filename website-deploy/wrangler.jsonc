{
  // Static site on Cloudflare Workers (assets only). The deploy script fills ./site from git HEAD.
  "name": "aicove-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "app.aicove.online", "custom_domain": true }]
}
