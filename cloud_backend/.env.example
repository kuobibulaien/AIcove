# Required. Generate separate persistent values; never commit real keys.
SECRET_KEY=
SYNC_V3_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./data/sync.db
SYNC_V3_BLOB_DIR=./data/sync3-blobs
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Optional comma-separated account IDs with non-expiring sessions.
# Empty keeps the standard token lifetime for every account.
PERSISTENT_SESSION_USER_IDS=
ALLOWED_ORIGINS=
