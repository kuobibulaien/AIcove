# 服务器配置
HOST=0.0.0.0
PORT=8000

# 安全密钥（生产环境请改为强随机字符串！）
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# JWT配置
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 数据库
DATABASE_URL=sqlite:///./data/sync.db

# CORS（允许的前端地址，生产环境改为具体域名）
ALLOWED_ORIGINS=*

# 加密（可选，但建议配置，避免服务重启后无法解密历史数据）
# - providers.api_keys 信封加密（AES-256-GCM，要求 base64 解码后是 32 字节）
#   生成方式：在 cloud_backend 目录执行 `python encryption.py`，复制输出的 KEK
# ENCRYPTION_KEK=base64-32-bytes
# - Key 分发/额度模块（Fernet）
#   生成方式：`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# ENCRYPTION_KEY=base64-fernet-key
