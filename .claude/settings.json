{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/memory.py start --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/memory.py prompt --agent claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": false
  },
  "enabledMcpjsonServers": ["dart"],
  "permissions": {
    "allow": [
      "Bash(grok-codex-agent:*)",
      "Bash(mktemp:*)",
      "Bash(cat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  }
}
